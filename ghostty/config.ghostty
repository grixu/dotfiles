# Wygląd i czcionka
font-family = "MonoLisa"
font-size = 16.0
#theme = catppuccin-mocha
background-opacity = 1.0

# Narzut okna i marginesy
window-padding-x = 8
window-padding-y = 10
window-decoration = true

# Zachowanie i wydajność
term = xterm-256color
macos-option-as-alt = left
macos-titlebar-style = tabs
cursor-style = block
shell-integration = zsh

# Kluczowa zmiana pod tmuxa: wyłączenie zbędnych skrótów okien Ghostty
keybind = super+d=unbind
keybind = super+shift+d=unbind

# Polskie ogonki
keybind = alt+a=unbind
keybind = alt+c=unbind
keybind = alt+s=unbind
keybind = alt+e=unbind
keybind = alt+o=unbind
keybind = alt+l=unbind
keybind = alt+z=unbind
keybind = alt+x=unbind
keybind = alt+n=unbind

# Przekierowanie Command
keybind = super+a=text:\x01

# Skróty klawiszowe
# prompt_tab_title, nie prompt_surface_title: tmux ciągle przestawia tytuł
# sekwencjami ucieczki, a tylko tytuł taba wygrywa z tym, co ustawia terminal.
keybind = super+shift+r=prompt_tab_title