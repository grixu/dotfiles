#!/usr/bin/env bash
#
# wt — create a git worktree next to the repo root, seed it with local
#      (gitignored) files, then run `pnpm install`.
#
# Usage:
#   wt <dir-name> [branch-name]
#
#   <dir-name>     Directory created as a sibling of the repository root.
#   [branch-name]  Branch to check out. Defaults to <dir-name>. An existing
#                  local branch is used as-is; a branch that exists only on
#                  the remote is checked out tracking it; otherwise a new
#                  branch is cut from origin/main.
#
# Example (run from anywhere inside a repo at ~/code/app):
#   wt feature-login            -> ~/code/feature-login on branch feature-login
#   wt review pr-42             -> ~/code/review        on branch pr-42

set -euo pipefail

# Branch the worktree is cut from. Override per-call: WT_BASE=origin/develop wt ...
BASE_REF="${WT_BASE:-origin/main}"

# Local, gitignored files copied into every new worktree. Add more freely.
LOCAL_FILES=(
  "CLAUDE.local.md"
  ".claude/settings.local.json"
)

die() { printf 'wt: %s\n' "$1" >&2; exit 1; }

[[ $# -ge 1 ]] || die "usage: wt <dir-name> [branch-name]"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "not inside a git repository"

worktree_name="$1"
branch_name="${2:-$1}"

repo_root="$(git rev-parse --show-toplevel)"
worktree_path="$(dirname "$repo_root")/$worktree_name"

[[ -e "$worktree_path" ]] && die "path already exists: $worktree_path"

# BASE_REF is "<remote>/<branch>"; existing branches are looked up on that remote.
remote="${BASE_REF%%/*}"

if git show-ref --verify --quiet "refs/heads/$branch_name"; then
  echo "==> Creating worktree $worktree_path (existing local branch: $branch_name)"
  git worktree add "$worktree_path" "$branch_name"
else
  remote_rc=0
  git ls-remote --exit-code --heads "$remote" "refs/heads/$branch_name" >/dev/null \
    || remote_rc=$?
  # 2 means "no matching ref"; anything else is a real failure (e.g. network),
  # which must not silently fall through to creating a duplicate branch.
  [[ $remote_rc -eq 0 || $remote_rc -eq 2 ]] \
    || die "failed to query remote $remote"

  if [[ $remote_rc -eq 0 ]]; then
    echo "==> Fetching $remote/$branch_name"
    git fetch "$remote" "+refs/heads/$branch_name:refs/remotes/$remote/$branch_name" --quiet \
      || die "failed to fetch $remote/$branch_name"

    echo "==> Creating worktree $worktree_path (tracking $remote/$branch_name)"
    git worktree add --track -b "$branch_name" "$worktree_path" "$remote/$branch_name"
  else
    echo "==> Fetching $BASE_REF"
    git fetch "$remote" "${BASE_REF#*/}" --quiet \
      || die "failed to fetch $BASE_REF"
    git rev-parse --verify --quiet "$BASE_REF" >/dev/null \
      || die "base ref not found: $BASE_REF"

    echo "==> Creating worktree $worktree_path (new branch: $branch_name from $BASE_REF)"
    git worktree add -b "$branch_name" "$worktree_path" "$BASE_REF"
  fi
fi

echo "==> Copying local files"
for file in "${LOCAL_FILES[@]}"; do
  src="$repo_root/$file"
  dest="$worktree_path/$file"
  if [[ -e "$src" ]]; then
    mkdir -p "$(dirname "$dest")"
    cp -R "$src" "$dest"
    echo "    + $file"
  else
    echo "    - $file (not found, skipped)"
  fi
done

if [[ -f "$worktree_path/package.json" ]]; then
  echo "==> Running pnpm install"
  ( cd "$worktree_path" && pnpm install )
else
  echo "==> No package.json, skipping pnpm install"
fi

echo "==> Done: $worktree_path"
